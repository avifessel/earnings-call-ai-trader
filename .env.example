# Your private keys. This file stays on your Mac; never share it or paste it into a chat.

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# From https://app.alpaca.markets (Paper account > API Keys). Free.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Optional settings (defaults shown) ---
# JUDGE_MODEL=claude-sonnet-5-5        # try claude-haiku-5-5 for cheaper/faster judging
# MIN_CONFIDENCE=0.70                  # only trade signals at or above this confidence
# COST_BPS_PER_SIDE=10                 # after-hours spread + slippage, each way (10 bps = 0.10%)
# TRANSCRIBE_LATENCY_SEC=0.5           # simulated live speech-to-text delay
# ORDER_LATENCY_SEC=1.0                # simulated order delay
# HEARTBEAT_SEC=90                     # ask the judge at least this often, even with no keywords
# MAX_JUDGE_CALLS=150                  # cost cap per earnings call
# ANONYMIZE=true                       # hide company name/ticker from the judge
